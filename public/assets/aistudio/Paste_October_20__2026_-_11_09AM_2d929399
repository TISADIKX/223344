
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>GutiAi Playground</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com">
  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Marked.js Markdown Engine -->
  <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>

  <style>
    * {
      outline: none !important;
      -webkit-tap-highlight-color: transparent;
    }

    body {
      font-family: 'Roboto', -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      background-color: #0b0c0f;
      overflow-x: hidden;
    }
    
    .material-symbols-outlined {
      font-variation-settings: 'FILL' 0, 'wght' 350, 'GRAD' 0, 'opsz' 20;
    }

    /* ROTATING 5-COLOR BORDER */
    @keyframes rotateConicBorder {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }
    .rotating-border-wrapper {
      position: relative;
      border-radius: 26px;
      overflow: hidden;
      padding: 2.2px;
    }
    .rotating-conic-glow {
      position: absolute;
      inset: -300%;
      background: conic-gradient(from 0deg, #ef476f 0%, #ffd166 20%, #06d6a0 40%, #118ab2 60%, #073b4c 80%, #ef476f 100%);
      filter: blur(14px);
      opacity: 0.55;
      animation: rotateConicBorder 5s linear infinite;
      pointer-events: none;
    }
    .rotating-conic-sharp {
      position: absolute;
      inset: -300%;
      background: conic-gradient(from 0deg, #ef476f 0%, #ffd166 20%, #06d6a0 40%, #118ab2 60%, #073b4c 80%, #ef476f 100%);
      animation: rotateConicBorder 5s linear infinite;
      pointer-events: none;
    }
    .rotating-border-wrapper:focus-within .rotating-conic-glow {
      opacity: 0.9;
      filter: blur(18px);
    }

    /* Google AI Studio Shimmer */
    @keyframes shimmer {
      0% { background-position: -200% 0; }
      100% { background-position: 200% 0; }
    }
    .thinking-shimmer {
      background: linear-gradient(90deg, #8e918f 0%, #e3e3e3 50%, #8e918f 100%);
      background-size: 200% 100%;
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      animation: shimmer 2s infinite linear;
    }

    /* Neutral Dark Buttons */
    .neutral-btn {
      background-color: #1a1c22;
      color: #e3e3e3;
      border: none !important;
      transition: background-color 0.2s ease;
    }
    .neutral-btn:hover {
      background-color: #262932;
      color: #ffffff;
    }

    /* AI STYLISH MARKDOWN & TABLES */
    .ai-output h1 { font-size: 1.35rem; font-weight: 700; color: #fff; margin: 1.1rem 0 0.5rem; }
    .ai-output h2 { font-size: 1.2rem; font-weight: 700; color: #fff; margin: 0.95rem 0 0.4rem; }
    .ai-output h3 { font-size: 1.05rem; font-weight: 600; color: #fff; margin: 0.8rem 0 0.35rem; }
    .ai-output p { margin-bottom: 0.65rem; line-height: 1.68; color: #e3e3e3; }
    .ai-output strong { font-weight: 600; color: #fff; }
    .ai-output em { color: #d1d5db; font-style: italic; }
    .ai-output ul { list-style-type: disc; padding-left: 1.3rem; margin-bottom: 0.8rem; }
    .ai-output ol { list-style-type: decimal; padding-left: 1.3rem; margin-bottom: 0.8rem; }
    .ai-output li { margin-bottom: 0.25rem; color: #e3e3e3; }
    .ai-output blockquote { border-left: 3px solid #118ab2; padding: 0.5rem 0.85rem; background: rgba(17,138,178,0.1); border-radius: 0 0.5rem 0.5rem 0; margin: 0.85rem 0; color: #cbd5e1; }
    .ai-output hr { border-color: rgba(255,255,255,0.08); margin: 1.25rem 0; }
    
    .ai-output table {
      width: 100%;
      border-collapse: collapse;
      margin: 1rem 0;
      font-size: 0.84rem;
      border-radius: 0.75rem;
      overflow: hidden;
      background: #14161d;
      border: 1px solid rgba(255,255,255,0.07);
      display: block;
      overflow-x: auto;
    }
    .ai-output th {
      background: #1c1f28;
      padding: 0.65rem 0.85rem;
      text-align: left;
      font-weight: 600;
      color: #fff;
      border-bottom: 1px solid rgba(255,255,255,0.08);
      white-space: nowrap;
    }
    .ai-output td {
      padding: 0.6rem 0.85rem;
      border-bottom: 1px solid rgba(255,255,255,0.05);
      color: #d1d5db;
      vertical-align: top;
      line-height: 1.5;
    }
    .ai-output tr:last-child td { border-bottom: none; }
    .ai-output tr:hover td { background: rgba(255,255,255,0.02); }

    .ai-output code { background: #1c1f28; padding: 0.15rem 0.4rem; border-radius: 0.35rem; font-family: monospace; font-size: 0.86em; color: #e2e8f0; }
    .ai-output pre { background: #12141a; padding: 0.85rem 1rem; border-radius: 0.75rem; border: 1px solid rgba(255,255,255,0.06); overflow-x: auto; margin: 0.85rem 0; }
    .ai-output pre code { background: transparent; padding: 0; color: #e2e8f0; }

    /* NO WHITE FRAME / REMOVE NATIVE SCROLLBAR ARTIFACTS */
    ::-webkit-scrollbar {
      width: 0px !important;
      height: 0px !important;
      background: transparent !important;
    }
    html, body, div {
      scrollbar-width: none !important;
      -ms-overflow-style: none !important;
    }
  </style>
</head>
<body class="min-h-screen text-[#e3e3e3] flex flex-col justify-between">

  <!-- Responsive Wrapper -->
  <div class="w-full flex-1 flex flex-col justify-between max-w-4xl mx-auto h-screen relative">
    
    <!-- Top Header -->
    <header class="w-full flex items-center justify-between px-4 sm:px-6 pt-4 pb-2 z-20">
      <div class="flex items-center gap-3">
        <button class="w-8 h-8 flex items-center justify-center rounded-full neutral-btn shadow-sm">
          <span class="material-symbols-outlined text-[18px]">menu</span>
        </button>
        <span class="text-[15px] font-medium tracking-tight text-white">GutiAi Playground</span>
      </div>

      <!-- Account Session -->
      <div class="relative">
        <button 

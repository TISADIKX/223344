    <!-- Chat Canvas -->
    <div id="chat-canvas" class="flex-1 overflow-y-auto px-4 sm:px-6 py-4 space-y-5 z-10">
      <div class="h-full flex flex-col items-center justify-center text-center text-[#8e918f] space-y-2 select-none" id="empty-state">

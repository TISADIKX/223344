                Run
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Auth Modal (Sign In, Create Account & OTP System) -->
    <div id="auth-modal" class="hidden fixed inset-0 bg-black/80 backdrop-blur-md z-50 flex items-center justify-center p-4">
      <div class="w-full max-w-[370px] bg-[#17181e] rounded-3xl p-6 shadow-2xl relative border border-white/5">
        <button id="close-modal-btn" class="absolute top-4 right-4 w-7 h-7 flex items-center justify-center rounded-full bg-white/5 text-[#9aa0a6] hover:text-white transition">
          <span class="material-symbols-outlined text-[18px]">close</span>
        </button>

        <div class="text-center mb-5">
          <div class="w-11 h-11 mx-auto mb-3 neutral-btn rounded-2xl flex items-center justify-center text-white">
            <span id="modal-icon" class="material-symbols-outlined text-[24px]">lock</span>
          </div>
          <h2 id="modal-title" class="text-[18px] font-semibold text-white">Sign in to GutiAi</h2>
          <p id="modal-subtitle" class="text-[12px] text-[#9aa0a6] mt-1">Sign in to access all AI features</p>
        </div>

        <!-- Notification Banner / OTP Display Alert -->
        <div id="auth-alert" class="hidden mb-3.5 px-3 py-2 bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-[12px] rounded-xl text-center"></div>

        <!-- 1. SIGN IN VIEW -->
        <div id="signin-view">
          <form id="login-form" class="space-y-3">
            <div>
              <input id="login-email" type="email" required placeholder="Email address" class="w-full bg-[#121316] text-[13px] rounded-xl px-3.5 py-2.5 text-white placeholder-[#75777a] border border-white/5" />
            </div>
            <div>
              <input id="login-password" type="password" required placeholder="Password" class="w-full bg-[#121316] text-[13px] rounded-xl px-3.5 py-2.5 text-white placeholder-[#75777a] border border-white/5" />
            </div>
            <button type="submit" class="w-full py-2.5 bg-white text-black font-semibold rounded-xl text-[13px] hover:bg-gray-200 transition mt-2">
              Sign In
            </button>
          </form>
          <div class="mt-4 text-center text-[12px] text-[#9aa0a6]">
            Don't have an account? 
            <button id="goto-signup-btn" class="text-white font-medium hover:underline ml-1">Create account</button>
          </div>
        </div>

        <!-- 2. CREATE ACCOUNT (SIGN UP) VIEW -->
        <div id="signup-view" class="hidden">
          <form id="signup-form" class="space-y-3">
            <div>
              <input id="signup-name" type="text" required placeholder="Full Name" class="w-full bg-[#121316] text-[13px] rounded-xl px-3.5 py-2.5 text-white placeholder-[#75777a] border border-white/5" />
            </div>
            <div>
              <input id="signup-email" type="email" required placeholder="Email address" class="w-full bg-[#121316] text-[13px] rounded-xl px-3.5 py-2.5 text-white placeholder-[#75777a] border border-white/5" />
            </div>
            <div>
              <input id="signup-password" type="password" required minlength="6" placeholder="Create Password" class="w-full bg-[#121316] text-[13px] rounded-xl px-3.5 py-2.5 text-white placeholder-[#75777a] border border-white/5" />
            </div>
            <button type="submit" class="w-full py-2.5 bg-white text-black font-semibold rounded-xl text-[13px] hover:bg-gray-200 transition mt-2">
              Get Verification Code
            </button>
          </form>
          <div class="mt-4 text-center text-[12px] text-[#9aa0a6]">
            Already have an account? 
            <button id="goto-signin-btn" class="text-white font-medium hover:underline ml-1">Sign in</button>
          </div>
        </div>

        <!-- 3. OTP VERIFICATION VIEW -->
        <div id="otp-view" class="hidden">
          <p class="text-[12px] text-center text-[#9aa0a6] mb-4">
            Enter the 6-digit code sent to <br><span id="otp-target-email" class="text-white font-medium"></span>
          </p>

          <form id="otp-form" class="space-y-4">
            <div class="flex justify-between gap-1.5">
              <input type="text" maxlength="1" class="otp-digit w-11 h-12 text-center text-[18px] font-bold bg-[#121316] text-white rounded-xl border border-white/10" />
              <input type="text" maxlength="1" class="otp-digit w-11 h-12 text-center text-[18px] font-bold bg-[#121316] text-white rounded-xl border border-white/10" />
              <input type="text" maxlength="1" class="otp-digit w-11 h-12 text-center text-[18px] font-bold bg-[#121316] text-white rounded-xl border border-white/10" />
              <input type="text" maxlength="1" class="otp-digit w-11 h-12 text-center text-[18px] font-bold bg-[#121316] text-white rounded-xl border border-white/10" />
              <input type="text" maxlength="1" class="otp-digit w-11 h-12 text-center text-[18px] font-bold bg-[#121316] text-white rounded-xl border border-white/10" />
              <input type="text" maxlength="1" class="otp-digit w-11 h-12 text-center text-[18px] font-bold bg-[#121316] text-white rounded-xl border border-white/10" />
            </div>

            <button type="submit" class="w-full py-2.5 bg-white text-black font-semibold rounded-xl text-[13px] hover:bg-gray-200 transition">
              Verify & Register
            </button>
          </form>

          <div class="mt-4 flex items-center justify-between text-[12px] text-[#9aa0a6] px-1">
            <button id="resend-otp-btn" class="hover:text-white transition">Resend Code</button>
            <button id="cancel-otp-btn" class="hover:text-white transition">Change Email</button>
          </div>
        </div>

      </div>
    </div>
  </div>

  <script>
    // --- XKIRO API CONFIGURATION (NO PUTER) ---
    const XKIRO_API_KEY = "sk-xt-ade0b61c4b191d01fd80b003eeff6ade5bfc774538bb64af";
    const XKIRO_BASE_URL = "https://api.xkiro.com/v1/chat/completions";
    const XKIRO_MODEL = "qwen/qwen3.8-omni-flash:free";

    // Chat and Input State
    let chatHistory = [];
    let attachedFiles = [];
    let pendingUserData = null;
    let generatedOtp = null;

    // DOM References
    const promptInput = document.getElementById('prompt-input');
    const runBtn = document.getElementById('run-btn');
    const chatCanvas = document.getElementById('chat-canvas');
    const emptyState = document.getElementById('empty-state');
    const addFileBtn = document.getElementById('add-file-btn');
    const uploadMenu = document.getElementById('upload-menu');
    const mediaFileInput = document.getElementById('media-file-input');
    const docFileInput = document.getElementById('doc-file-input');
    const filePreviews = document.getElementById('file-previews');
    const micBtn = document.getElementById('mic-btn');
    const listeningBadge = document.getElementById('listening-badge');
    const recordingTimer = document.getElementById('recording-timer');
    const recordingPulseDot = document.getElementById('recording-pulse-dot');
    
    // Auth DOM References
    const openLoginBtn = document.getElementById('open-login-btn');
    const authModal = document.getElementById('auth-modal');
    const closeModalBtn = document.getElementById('close-modal-btn');
    const modalIcon = document.getElementById('modal-icon');
    const modalTitle = document.getElementById('modal-title');
    const modalSubtitle = document.getElementById('modal-subtitle');
    const authAlert = document.getElementById('auth-alert');
    
    const signinView = document.getElementById('signin-view');
    const signupView = document.getElementById('signup-view');
    const otpView = document.getElementById('otp-view');

    const gotoSignupBtn = document.getElementById('goto-signup-btn');
    const gotoSigninBtn = document.getElementById('goto-signin-btn');
    const resendOtpBtn = document.getElementById('resend-otp-btn');
    const cancelOtpBtn = document.getElementById('cancel-otp-btn');

    const loginForm = document.getElementById('login-form');
    const signupForm = document.getElementById('signup-form');
    const otpForm = document.getElementById('otp-form');
    const otpDigits = document.querySelectorAll('.otp-digit');
    const otpTargetEmail = document.getElementById('otp-target-email');

    const userProfile = document.getElementById('user-profile');
    const profileDropdownBtn = document.getElementById('profile-dropdown-btn');
    const profileMenu = document.getElementById('profile-menu');
    const logoutBtn = document.getElementById('logout-btn');
    const userDisplayName = document.getElementById('user-display-name');
    const userDisplayEmail = document.getElementById('user-display-email');

    // Local account storage
    function getUsers() {
      return JSON.parse(localStorage.getItem('gutiai_users') || '[]');
    }

    function saveUser(user) {
      const users = getUsers();
      users.push(user);
      localStorage.setItem('gutiai_users', JSON.stringify(users));
    }

    // Switch between Sign In, Sign Up, and OTP view
    function switchAuthView(view) {
      authAlert.classList.add('hidden');
      signinView.classList.add('hidden');
      signupView.classList.add('hidden');
      otpView.classList.add('hidden');

      if (view === 'signin') {
        signinView.classList.remove('hidden');
        modalIcon.textContent = 'lock';
        modalTitle.textContent = 'Sign in to GutiAi';
        modalSubtitle.textContent = 'Sign in to access all AI features';
      } else if (view === 'signup') {
        signupView.classList.remove('hidden');
        modalIcon.textContent = 'person_add';
        modalTitle.textContent = 'Create an Account';
        modalSubtitle.textContent = 'Get started with your free GutiAi account';
      } else if (view === 'otp') {
        otpView.classList.remove('hidden');
        modalIcon.textContent = 'mark_email_read';
        modalTitle.textContent = 'Verification Code';
        modalSubtitle.textContent = 'Enter the code to verify your account';
        otpDigits[0].focus();
      }
    }

    gotoSignupBtn.addEventListener('click', () => switchAuthView('signup'));
    gotoSigninBtn.addEventListener('click', () => switchAuthView('signin'));
    cancelOtpBtn.addEventListener('click', () => switchAuthView('signup'));

    // Handle Sign Up & Trigger OTP
    signupForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const name = document.getElementById('signup-name').value.trim();
      const email = document.getElementById('signup-email').value.trim();
      const password = document.getElementById('signup-password').value;

      const users = getUsers();
      if (users.find(u => u.email.toLowerCase() === email.toLowerCase())) {
        authAlert.textContent = "An account with this email already exists.";
        authAlert.className = "mb-3.5 px-3 py-2 bg-red-500/10 border border-red-500/20 text-red-400 text-[12px] rounded-xl text-center";
        authAlert.classList.remove('hidden');
        return;
      }

      pendingUserData = { name, email, password };
      sendVerificationOtp(email);
    });

    function sendVerificationOtp(email) {
      generatedOtp = Math.floor(100000 + Math.random() * 900000).toString();
      otpTargetEmail.textContent = email;

      authAlert.innerHTML = `Your verification code is: <strong class="text-white tracking-widest text-[14px]">${generatedOtp}</strong>`;
      authAlert.className = "mb-3.5 px-3 py-2 bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-[12px] rounded-xl text-center";
      authAlert.classList.remove('hidden');

      switchAuthView('otp');
      otpDigits.forEach(input => input.value = '');
    }

    resendOtpBtn.addEventListener('click', () => {
      if (pendingUserData) {
        sendVerificationOtp(pendingUserData.email);
      }
    });

    // Auto-advance OTP Inputs
    otpDigits.forEach((input, idx) => {
      input.addEventListener('input', (e) => {
        if (e.target.value.length === 1 && idx < otpDigits.length - 1) {
          otpDigits[idx + 1].focus();
        }
      });
      input.addEventListener('keydown', (e) => {
        if (e.key === 'Backspace' && !e.target.value && idx > 0) {
          otpDigits[idx - 1].focus();
        }
      });
    });

    // OTP Verification Submit
    otpForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const enteredOtp = Array.from(otpDigits).map(input => input.value).join('');

      if (enteredOtp !== generatedOtp) {
        authAlert.textContent = "Invalid code. Please check and try again.";
        authAlert.className = "mb-3.5 px-3 py-2 bg-red-500/10 border border-red-500/20 text-red-400 text-[12px] rounded-xl text-center";
        authAlert.classList.remove('hidden');
        return;
      }

      saveUser(pendingUserData);
      loginUser(pendingUserData.name, pendingUserData.email);
      signupForm.reset();
      otpForm.reset();
      pendingUserData = null;
      generatedOtp = null;
    });

    // Handle Login Submit
    loginForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const email = document.getElementById('login-email').value.trim();
      const password = document.getElementById('login-password').value;

      const users = getUsers();
      const user = users.find(u => u.email.toLowerCase() === email.toLowerCase() && u.password === password);

      if (!user && users.length > 0) {
        authAlert.textContent = "Incorrect email or password.";
        authAlert.className = "mb-3.5 px-3 py-2 bg-red-500/10 border border-red-500/20 text-red-400 text-[12px] rounded-xl text-center";
        authAlert.classList.remove('hidden');
        return;
      }

      const name = user ? user.name : email.split('@')[0];
      loginUser(name, email);
    });

    function loginUser(name, email) {
      openLoginBtn.classList.add('hidden');
      userProfile.classList.remove('hidden');
      profileDropdownBtn.textContent = name.charAt(0).toUpperCase();
      userDisplayName.textContent = name;
      userDisplayEmail.textContent = email;
      authModal.classList.add('hidden');
    }

    openLoginBtn.addEventListener('click', () => {
      switchAuthView('signin');
      authModal.classList.remove('hidden');
    });

    closeModalBtn.addEventListener('click', () => authModal.classList.add('hidden'));

    profileDropdownBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      profileMenu.classList.toggle('hidden');
    });

    document.addEventListener('click', () => profileMenu.classList.add('hidden'));

    logoutBtn.addEventListener('click', () => {
      userProfile.classList.add('hidden');
      openLoginBtn.classList.remove('hidden');
      profileMenu.classList.add('hidden');
    });

    // Auto-grow textarea & validation
    promptInput.addEventListener('input', () => {
      promptInput.style.height = 'auto';
      promptInput.style.height = (promptInput.scrollHeight) + 'px';
      
      const hasContent = promptInput.value.trim().length > 0 || attachedFiles.length > 0;
      runBtn.disabled = !hasContent;
      if (hasContent) {
        runBtn.className = "px-4 py-1.5 bg-white text-black text-[13px] font-semibold rounded-xl cursor-pointer hover:bg-gray-200 transition-all duration-150";
      } else {
        runBtn.className = "px-4 py-1.5 bg-[#1b1c22] text-[#5f6368] text-[13px] font-semibold rounded-xl cursor-not-allowed transition-all duration-150";
      }
    });

    promptInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        if (!runBtn.disabled) handleSend();
      }
    });

    runBtn.addEventListener('click', handleSend);

    // Call xkiro API
    async function queryXkiro(messages) {
      const response = await fetch(XKIRO_BASE_URL, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "Authorization": `Bearer ${XKIRO_API_KEY}`
        },
        body: JSON.stringify({
          model: XKIRO_MODEL,
          messages: messages
        })
      });

      if (!response.ok) {
        const errorText = await response.text();
        throw new Error(`xkiro error ${response.status}: ${errorText || response.statusText}`);
      }

      const data = await response.json();
      return data.choices[0].message.content;
    }

    // Send logic (Direct xkiro without Puter)
    async function handleSend() {
      const text = promptInput.value.trim();
      if (!text && attachedFiles.length === 0) return;

      if (emptyState) emptyState.style.display = 'none';

      let userPrompt = text;
      if (attachedFiles.length > 0) {
        const fileNames = attachedFiles.map(f => f.name).join(", ");
        userPrompt += `\n\n[Attached files: ${fileNames}]`;
      }

      appendMessage('user', userPrompt);
      chatHistory.push({ role: "user", content: userPrompt });

      promptInput.value = '';
      promptInput.style.height = 'auto';
      attachedFiles = [];
      renderFilePreviews();
      runBtn.disabled = true;
      runBtn.className = "px-4 py-1.5 bg-[#1b1c22] text-[#5f6368] text-[13px] font-semibold rounded-xl cursor-not-allowed transition-all duration-150";

      const thinkingBubble = appendThinkingMessage();

      try {
        const assistantReply = await queryXkiro(chatHistory);
        replaceThinkingWithMessage(thinkingBubble, assistantReply);
        chatHistory.push({ role: "assistant", content: assistantReply });
      } catch (err) {
        console.error("xkiro API Error:", err);
        replaceThinkingWithMessage(thinkingBubble, `**Request failed:** ${err.message || 'Unable to connect to xkiro.com API. Please check your network connection.'}`);
      }
    }

    function appendMessage(role, content) {
      const wrapper = document.createElement('div');
      wrapper.className = `flex ${role === 'user' ? 'justify-end' : 'justify-start'} w-full`;

      const bubble = document.createElement('div');
      if (role === 'user') {
        bubble.className = "max-w-[85%] sm:max-w-[75%] bg-[#1e2027] text-white px-4 py-2.5 rounded-2xl text-[14.5px] leading-relaxed break-words border border-white/5";
        bubble.textContent = content;
      } else {
        bubble.className = "max-w-full w-full ai-output text-[#e3e3e3] px-2 py-1 text-[14.5px]";
        bubble.innerHTML = marked.parse(content);
      }

      wrapper.appendChild(bubble);
      chatCanvas.appendChild(wrapper);
      chatCanvas.scrollTop = chatCanvas.scrollHeight;
      return wrapper;
    }

    function appendThinkingMessage() {
      const wrapper = document.createElement('div');
      wrapper.className = "flex justify-start w-full";

      const bubble = document.createElement('div');
      bubble.className = "px-2 py-1 flex items-center gap-2";
      bubble.innerHTML = `
        <span class="material-symbols-outlined text-[18px] text-[#118ab2] animate-spin">progress_activity</span>
        <span class="thinking-shimmer text-[14px] font-medium">Thinking...</span>
      `;

      wrapper.appendChild(bubble);
      chatCanvas.appendChild(wrapper);
      chatCanvas.scrollTop = chatCanvas.scrollHeight;
      return wrapper;
    }

    function replaceThinkingWithMessage(thinkingWrapper, content) {
      thinkingWrapper.innerHTML = '';
      const bubble = document.createElement('div');
      bubble.className = "max-w-full w-full ai-output text-[#e3e3e3] px-2 py-1 text-[14.5px]";
      bubble.innerHTML = marked.parse(content);
      thinkingWrapper.appendChild(bubble);
      chatCanvas.scrollTop = chatCanvas.scrollHeight;
    }

    // Attachments Handling
    addFileBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      uploadMenu.classList.toggle('hidden');
    });

    document.addEventListener('click', () => uploadMenu.classList.add('hidden'));

    document.getElementById('upload-media-btn').addEventListener('click', () => {
      mediaFileInput.click();
      uploadMenu.classList.add('hidden');
    });

    document.getElementById('upload-doc-btn').addEventListener('click', () => {
      docFileInput.click();
      uploadMenu.classList.add('hidden');
    });

    function handleFileSelect(e) {
      const files = Array.from(e.target.files);
      files.forEach(f => attachedFiles.push(f));
      renderFilePreviews();
      promptInput.dispatchEvent(new Event('input'));
    }

    mediaFileInput.addEventListener('change', handleFileSelect);
    docFileInput.addEventListener('change', handleFileSelect);

    function renderFilePreviews() {
      filePreviews.innerHTML = '';
      if (attachedFiles.length === 0) {
        filePreviews.classList.add('hidden');
        return;
      }
      filePreviews.classList.remove('hidden');

      attachedFiles.forEach((file, index) => {
        const item = document.createElement('div');
        item.className = "flex items-center gap-1.5 bg-[#1b1d24] border border-white/10 px-2.5 py-1 rounded-lg text-[12px] text-white";
        item.innerHTML = `
          <span class="material-symbols-outlined text-[14px] text-gray-400">attach_file</span>
          <span class="max-w-[120px] truncate">${file.name}</span>
          <button type="button" class="ml-1 text-gray-400 hover:text-white" onclick="removeFile(${index})">
            <span class="material-symbols-outlined text-[14px]">close</span>
          </button>
        `;
        filePreviews.appendChild(item);
      });
    }

    window.removeFile = function(index) {
      attachedFiles.splice(index, 1);
      renderFilePreviews();
      promptInput.dispatchEvent(new Event('input'));
    };

    // Voice recognition (Web Speech API)
    let recognition = null;
    let isRecording = false;
    let timerInterval = null;
    let seconds = 0;

    if ('webkitSpeechRecognition' in window || 'SpeechRecognition' in window) {
      const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
      recognition = new SpeechRecognition();
      recognition.continuous = true;
      recognition.interimResults = true;

      recognition.onresult = (event) => {
        let transcript = '';
        for (let i = event.resultIndex; i < event.results.length; ++i) {
          transcript += event.results[i][0].transcript;
        }
        promptInput.value = transcript;
        promptInput.dispatchEvent(new Event('input'));
      };

      recognition.onerror = () => stopRecording();
      recognition.onend = () => stopRecording();
    }

    micBtn.addEventListener('click', () => {
      if (!recognition) {
        alert("Speech Recognition is not supported by your browser.");
        return;
      }
      if (!isRecording) startRecording();
      else stopRecording();
    });

    function startRecording() {
      try {
        recognition.start();
        isRecording = true;
        seconds = 0;
        listeningBadge.classList.remove('hidden');
        recordingPulseDot.classList.remove('hidden');
        timerInterval = setInterval(() => {
          seconds++;
          recordingTimer.textContent = `${seconds}s`;
        }, 1000);
      } catch (err) {
        console.error(err);
      }
    }

    function stopRecording() {
      if (!isRecording) return;
      isRecording = false;
      try { recognition.stop(); } catch(e){}
      clearInterval(timerInterval);
      listeningBadge.classList.add('hidden');
      recordingPulseDot.classList.add('hidden');
    }
  </script>
</body>

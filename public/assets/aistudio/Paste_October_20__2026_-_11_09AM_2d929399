    <!-- Hidden Native File Inputs -->
    <input type="file" id="media-file-input" accept="image/*,video/*" multiple class="hidden" />
    <input type="file" id="doc-file-input" accept="*/*" multiple class="hidden" />

    <!-- Prompt Input Container -->
    <div class="p-3 sm:p-5 z-10 w-full relative">
      
      <!-- Upload Menu -->
      <div 
        id="upload-menu" 
        class="hidden absolute left-4 sm:left-6 bottom-20 sm:bottom-24 bg-[#181a20] rounded-2xl p-1.5 shadow-2xl z-30 w-52 border border-white/5"
      >
        <button id="upload-media-btn" class="w-full flex items-center gap-2.5 px-3 py-2 text-[13px] text-[#e3e3e3] hover:bg-white/5 rounded-xl transition text-left">
          <span class="material-symbols-outlined text-[18px] text-[#9aa0a6]">perm_media</span>
          <span>Photos & Videos</span>
        </button>
        <button id="upload-doc-btn" class="w-full flex items-center gap-2.5 px-3 py-2 text-[13px] text-[#e3e3e3] hover:bg-white/5 rounded-xl transition text-left">
          <span class="material-symbols-outlined text-[18px] text-[#9aa0a6]">upload_file</span>
          <span>Upload files</span>
        </button>
      </div>

      <!-- Rotating 5-Color Glowing Border -->
      <div class="rotating-border-wrapper shadow-2xl">
        <div class="rotating-conic-glow"></div>
        <div class="rotating-conic-sharp"></div>

        <div class="relative bg-[#131419] rounded-[24px] p-3 sm:p-4 z-10 w-full">
          <div id="file-previews" class="hidden flex-wrap gap-2 mb-2.5 max-h-36 overflow-y-auto pt-1"></div>

          <textarea 
            id="prompt-input"
            rows="1"
            placeholder="Ask a question..." 
            class="w-full bg-transparent text-[#e3e3e3] placeholder-[#8e918f] text-[15px] sm:text-[16px] outline-none mb-3 resize-none max-h-32"
          ></textarea>

          <div class="flex items-center justify-between pt-1">
            <div class="flex items-center gap-2">
              <button id="add-file-btn" type="button" title="Add files" class="w-8 h-8 rounded-full flex items-center justify-center neutral-btn shadow-sm">
                <span class="material-symbols-outlined text-[18px]">add</span>
              </button>
            </div>

            <div class="flex items-center gap-2">
              <div id="listening-badge" class="hidden flex items-center gap-1.5 px-3 py-1 neutral-btn rounded-full text-[11px]">

# Block direct browser access to server-side PHP secrets file
<Files "php-config.php">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</Files>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Serve existing files (including generate.php, config.js, assets/) directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # SPA Fallback to relative index.html
  RewriteRule ^ index.html [L]
</IfModule>

# MIME types for modern web assets
<IfModule mod_mime.c>
  AddType image/svg+xml .svg
  AddType application/manifest+json .webmanifest
  AddType video/mp4 .mp4
  AddType image/webp .webp
</IfModule>

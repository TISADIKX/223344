{
  "entities": {
    "UserChatSession": {
      "title": "UserChatSession",
      "description": "A persistent chat session belonging strictly to a single authenticated user.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique session ID."
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the session owner."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Title of the chat session."
        },
        "chatMode": {
          "type": "string",
          "enum": ["chat", "photo", "video"],
          "description": "Active generation mode for this session."
        },
        "messages": {
          "type": "string",
          "maxLength": 900000,
          "description": "JSON serialized messages in the session."
        },
        "createdAt": {
          "type": "number",
          "description": "Creation timestamp in milliseconds."
        },
        "updatedAt": {
          "type": "number",
          "description": "Last updated timestamp in milliseconds."
        }
      },
      "required": ["id", "userId", "title", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}/sessions/{sessionId}": {
      "schema": {
        "$ref": "#/entities/UserChatSession"
      },
      "description": "User private chat sessions stored permanently and isolated per user UID in Firestore."
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default deny all unknown paths
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidSession(data, userId, sessionId) {
      return data.keys().hasAll(['id', 'userId', 'title', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'userId', 'title', 'chatMode', 'messages', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.id == sessionId
        && isValidId(data.userId)
        && data.userId == userId
        && data.userId == request.auth.uid
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 100
        && (!('chatMode' in data) || (data.chatMode is string && data.chatMode in ['chat', 'photo', 'video']))
        && (!('messages' in data) || (data.messages is string && data.messages.size() <= 900000))
        && data.createdAt is number
        && data.updatedAt is number;
    }

    // Chat sessions collection strictly isolated per authenticated user UID
    match /users/{userId}/sessions/{sessionId} {
      allow get: if isOwner(userId) && isValidId(sessionId);
      allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
      allow create: if isOwner(userId)
                    && isValidId(sessionId)
                    && isValidSession(incoming(), userId, sessionId);
      allow update: if isOwner(userId)
                    && isValidId(sessionId)
                    && isValidSession(incoming(), userId, sessionId)
                    && incoming().userId == existing().userId
                    && incoming().id == existing().id
                    && incoming().createdAt == existing().createdAt
                    && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'chatMode', 'messages', 'updatedAt']);
      allow delete: if isOwner(userId) && isValidId(sessionId);
    }
  }
}
